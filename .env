# Server Configuration
  HOST=0.0.0.0
  PORT=8000
  RELOAD=true

  # Model Configuration
  MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
  DEVICE=cpu
  DEFAULT_VOICE=en-Carter_man

  # Performance Settings
  INFERENCE_STEPS=5
  CFG_SCALE=1.5

Importante:
  - DEVICE=cpu - Porque no hay GPU dedicada (en GCP cambiaremos a cuda)
  - DEFAULT_VOICE=en-Carter_man - Una de las voces disponibles en VibeVoice