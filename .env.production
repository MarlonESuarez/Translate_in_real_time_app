# Production Environment Variables for Google Cloud Run
# DO NOT commit secrets to version control!

# Server Configuration
HOST=0.0.0.0
PORT=8080
RELOAD=false

# Model Configuration
MODEL_PATH=microsoft/VibeVoice-Realtime-0.5B
DEVICE=cpu
DEFAULT_VOICE=en-Carter_man

# Performance Settings (optimized for production)
INFERENCE_STEPS=5
CFG_SCALE=1.5

